@model OlympicsViewModel
@{
    ViewData["Title"] = "Favorites";
}

<div class="text-center mb-4">
    <h2>My Favorites</h2>
    <form asp-action="Delete" method="post" asp-controller="Favorites">
        <a asp-action="Index" asp-controller="Home" class="btn btn-primary"
           asp-route-activeGame ="@Model.ActiveGame" 
           asp-route-activeCat ="@Model.ActiveCat">
            Back to Home Page
        </a>
        <button type="submit" class="btn btn-primary">
            Clear Favorites
        </button>
    </form>
</div>

<div class="row">
    <div class="col-sm-8 offset-sm-2">
        <ul class="list-group">
            @foreach (Country country in Model.Countries)
            {
                <li class="list-group-item">
                    <div class="row">
                        <div class="col-sm-4">
                            <img src="~/images/@country.LogoImage" alt="@country.Name" style="width:100px;" />
                        </div>
                        <div class="col-sm-4">
                            @country.Name
                        </div>
                        <div class="col-sm-4">
                            @country.Game.Name @country.Category.Name
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>
</div>