@model OlympicsViewModel
@{
    ViewData["Title"] = "Country Details";
}

<h2 class="text-center p-2">Country Details</h2>

<div class="row">
    <div class="col-sm-6 offset-sm-3">
        <ul class="list-group text-center">
            <li class="list-group-item">
                <img src="~/images/@Model.Country.LogoImage" alt="@Model.Country.Name" style="width:300px;" />
                <h3>@Model.Country.Name</h3>
            </li>
            <li class="list-group-item">
                <h4>Game: @Model.Country.Game.Name</h4>
            </li>
            <li class="list-group-item">
                <h4>Category: @Model.Country.Category.Name</h4>
            </li>
            <li class="list-group-item">
                <h4>Sport: @Model.Country.Sport</h4>
            </li>
            <li class="list-group-item">
                <a asp-action="Index" 
                   asp-route-activeGame="@Model.ActiveGame"
                   asp-route-activeCat="@Model.ActiveCat"
                   class="btn btn-primary">Return to Home Page</a>
            </li>
        </ul>
    </div>
</div>