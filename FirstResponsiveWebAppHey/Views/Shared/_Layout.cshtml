@{
    string controller = 
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <title>@ViewBag.Title</title>
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">My Web App</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarCollapse" 
                    aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex flex-sm-row-reverse" id="navbarCollapse">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-dark" href="#" id="assignmentsDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Assignments
                        </a>
                        <div class="dropdown-menu" aria-labelledby="assignmentsDropdown">
                            <a class="dropdown-item" asp-controller="Assignments" asp-action="DefaultRoute">Default Route</a>
                            <a class="dropdown-item" asp-controller="Assignments" asp-action="CustomRule">Custom Rule</a>
                            <a class="dropdown-item" asp-controller="Assignments" asp-action="AttributeRoute">Attribute Route</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" asp-controller="Assignment6_1" asp-action="Index" asp-route-accessLevel="1">Assignment 6.1</a>
                            <a class="dropdown-item" asp-controller="Olympics" asp-action="Index">Olympic Games</a>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container">
        <header class="text-center">
            @if (TempData.Keys.Contains("message"))
            {
                <h4 class="bg-success p-2">@TempData["message"]</h4>
            }

            @if (controller != "Favorites")
            {
                var session = new OlympicsSession(Context.Session);
                int? count = session.GetMyCountryCount();

                @if (count.HasValue && count > 0)
                {
                    <h5 class="bg-info p-2 text-white">
                        <a asp-controller="Favorites" asp-action="Index" 
                           class="text-white">My Favorite Countries</a>
                    </h5>
                }
            }
        </header>
        <main>
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/popper/popper.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.min.js"></script>
</body>
</html>