@model IEnumerable<Ticket>

<div class="row">
    <div class="col-md-3">
        <h3 class="mt-3">Status</h3>
        <vc:status-filter active-status="@ViewBag.Filters.StatusId"></vc:status-filter>
        <a asp-action="Index" asp-route-id="" class="btn btn-secondary mt-3">Clear</a>
    </div>
    <div class="col-md-9">
        <form asp-action="MarkDone" method="post" 
            asp-route-id="@ViewBag.Filters.FilterString">

            <table class="table table-bordered table-striped mt-2">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Sprint</th>
                        <th>Points</th>
                        <th>Status</th>
                        <th>Date Opened</th>
                        <th class="w-25"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (Ticket ticket in Model)
                {
                    <tr>
                        <td>@ticket.Name</td>
                        <td>@ticket.Description</td>
                        <td>@ticket.SprintNumber</td>
                        <td>@ticket.PointValue</td>
                        <td>@ticket.Status.Name</td>
                        <td>@ticket.DateOpened.ToShortDateString()</td>
                        <td>
                        @if (ticket.StatusId != "done")
                        {
                            <button type="submit" class="btn-sm" 
                                    name="@nameof(Ticket.Id)" value="@ticket.Id">
                                    Mark Done
                            </button>
                        }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </form>
        <form asp-action="DeleteDone" method="post" 
            asp-route-id="@ViewBag.Filters.FilterString">

            <a asp-action="Add" class="btn btn-primary">Add new ticket</a>
            <button type="submit" class="btn-danger">Delete done tickets</button>
        </form>
    </div>
</div>
