@model IEnumerable<JobHunter.Models.JobApplication>
@{
    ViewBag.Title = "My Job Applications";
}

<div class="row">
    <div class="col-md-3">
        <form asp-action="Filter" method="post">
            <h3 class="mt-3">Status</h3>
            <select name="filter" class="form-select" 
                    asp-items="@(new SelectList(ViewBag.Statuses, "StatusId", "Name", ViewBag.Filters.StatusId))">
                <option value="all">All</option>
            </select>

            <button type="submit" class="btn btn-primary mt-3">Filter</button>
            <a asp-action="Index" asp-route-id="all" class="btn btn-secondary mt-3">Clear</a>
        </form>
    </div>

    <div class="col-md-9">
        <table class="table table-bordered table-striped mt-3">
            <thead>
                <tr>
                    <th></th>
                    <th>Company</th>
                    <th>Job Title</th>
                    <th>Location</th>
                    <th>Applied</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Model)
                {
                    bool isFavorite = ((List<int>)ViewBag.Favorites).Contains(job.Id);
                    <tr>
                        <td>
                            <form asp-action="Favorite" method="post" asp-route-id="@ViewContext.RouteData.Values["id"]">
                                <input type="hidden" name="id" value="@job.Id" />
                                <button type="submit" class="btn btn-sm">
                                    <i class="fas fa-heart @(isFavorite ? "text-danger" : "text-secondary")"></i>
                                </button>
                            </form>
                        </td>
                        <td>@job.CompanyName</td>
                        <td>@job.JobTitle</td>
                        <td>@job.Location</td>
                        <td>@job.ApplicationDate.ToShortDateString()</td>
                        <td>@job.Status?.Name</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@job.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a asp-action="Create" class="btn btn-primary">Add new job application</a>
        </div>
    </div>
</div>
